---
import Layout from "../layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Create account">
  <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6">
    <h1 class="text-2xl font-semibold">Create your account</h1>
    <p class="mt-2 text-sm text-slate-600">Register to access the Stock System.</p>

    {error === "exists" && (
      <p class="mt-4 rounded-md bg-amber-50 p-3 text-sm text-amber-800" role="alert">
        An account with that email already exists. <a class="underline" href="/login">Sign in</a> instead.
      </p>
    )}
    {error === "invalid" && (
      <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700" role="alert">
        Enter a valid email and a password with at least 12 characters.
      </p>
    )}

    <form method="POST" action="/api/auth/register" class="mt-6 flex flex-col gap-4">
      <label class="flex flex-col gap-1 text-sm font-medium">
        Email
        <input
          type="email"
          name="email"
          autocomplete="email"
          maxlength="254"
          required
          class="rounded-md border border-slate-300 px-3 py-2"
        />
      </label>

      <label class="flex flex-col gap-1 text-sm font-medium">
        Password
        <input
          type="password"
          name="password"
          autocomplete="new-password"
          minlength="12"
          maxlength="1024"
          required
          class="rounded-md border border-slate-300 px-3 py-2"
        />
        <span class="text-xs font-normal text-slate-500">Use at least 12 characters.</span>
      </label>

      <button
        type="submit"
        class="rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700"
      >
        Create account
      </button>
    </form>

    <p class="mt-6 text-sm text-slate-600">
      Already have an account? <a class="font-medium text-slate-900 underline" href="/login">Sign in</a>
    </p>
  </main>
</Layout>
