---
import Layout from "../layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center px-6">
    <h1 class="text-2xl font-semibold">Sign in</h1>
    <p class="mt-2 text-sm text-slate-600">Sign in to manage your inventory.</p>

    {error === "invalid" && (
      <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700" role="alert">
        The email or password is incorrect.
      </p>
    )}

    <form method="POST" action="/api/auth/login" class="mt-6 flex flex-col gap-4">
      <label class="flex flex-col gap-1 text-sm font-medium">
        Email
        <input
          type="email"
          name="email"
          autocomplete="email"
          maxlength="254"
          required
          class="rounded-md border border-slate-300 px-3 py-2"
        />
      </label>

      <label class="flex flex-col gap-1 text-sm font-medium">
        Password
        <input
          type="password"
          name="password"
          autocomplete="current-password"
          maxlength="1024"
          required
          class="rounded-md border border-slate-300 px-3 py-2"
        />
      </label>

      <button
        type="submit"
        class="rounded-md bg-slate-900 px-4 py-2 font-medium text-white hover:bg-slate-700"
      >
        Sign in
      </button>
    </form>

    <p class="mt-6 text-sm text-slate-600">
      Need an account? <a class="font-medium text-slate-900 underline" href="/register">Create one</a>
    </p>
  </main>
</Layout>
