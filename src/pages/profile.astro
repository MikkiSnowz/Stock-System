---
import { env } from "cloudflare:workers";
import AppLayout from "../layouts/AppLayout.astro";

interface ProfileRow {
  email: string;
  full_name: string | null;
  phone: string | null;
  job_title: string | null;
  department: string | null;
  bio: string | null;
}

const profile = await env.stock_db.prepare(`
  SELECT u.email, p.full_name, p.phone, p.job_title, p.department, p.bio
  FROM users u
  LEFT JOIN user_profiles p ON p.user_id = u.id
  WHERE u.id = ?
`).bind(Astro.locals.userId).first<ProfileRow>();

if (!profile) return Astro.redirect("/login");

const saved = Astro.url.searchParams.get("saved") === "1";
const error = Astro.url.searchParams.get("error");
const inputClass =
  "rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500";
const labelClass = "flex flex-col gap-1 text-sm font-medium text-slate-700";
---

<AppLayout title="Profile">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-2xl font-semibold tracking-tight">User Profile</h1>

    {saved && (
      <p class="mt-4 rounded-md bg-green-50 p-3 text-sm text-green-800" role="status">
        Profile saved.
      </p>
    )}
    {error === "invalid" && (
      <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700" role="alert">
        One of the fields is too long. Please shorten it and try again.
      </p>
    )}
    {error === "phone" && (
  <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700" role="alert">
    Phone number must be exactly 10 digits.
  </p>
)}

    <section class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <form method="POST" action="/api/profile" class="flex flex-col gap-4">
        <label class={labelClass}>
          Email
          <input type="email" value={profile.email} disabled class={`${inputClass} bg-slate-100 text-slate-500`} />
        </label>
        <label class={labelClass}>
          Full name
          <input type="text" name="full_name" value={profile.full_name ?? ""} maxlength="100" autocomplete="name" class={inputClass} />
        </label>
        <label class={labelClass}>
          Phone
          <input type="tel" name="phone" value={profile.phone ?? ""} inputmode="numeric" pattern="[0-9]{10}" maxlength="10" autocomplete="tel" class={inputClass} />
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class={labelClass}>
            Job title
            <input type="text" name="job_title" value={profile.job_title ?? ""} maxlength="100" autocomplete="organization-title" class={inputClass} />
          </label>
          <label class={labelClass}>
            Department
            <input type="text" name="department" value={profile.department ?? ""} maxlength="100" class={inputClass} />
          </label>
        </div>
        <label class={labelClass}>
          Bio
          <textarea name="bio" rows="4" maxlength="500" class={inputClass}>{profile.bio ?? ""}</textarea>
        </label>
        <button
          type="submit"
          class="self-start rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
        >
          Save profile
        </button>
      </form>
    </section>
  </div>
</AppLayout>
