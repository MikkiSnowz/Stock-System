---
import { env } from "cloudflare:workers";
import AppLayout from "../layouts/AppLayout.astro";

interface ProductRow {
  id: number;
  name: string;
  quantity: number | null;
}

const db = env.stock_db;
const { results } = await db.prepare(`
  SELECT p.id, p.name, SUM(sl.quantity) as quantity
  FROM products p
  LEFT JOIN stock_levels sl ON sl.product_id = p.id
  GROUP BY p.id, p.name
`).all();
const products = results as unknown as ProductRow[];
---

<AppLayout title="Stock System">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-2xl font-semibold tracking-tight">Product Inventory</h1>

    <div class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
      {products.length === 0 ? (
        <p class="p-6 text-sm text-slate-500">No products yet.</p>
      ) : (
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 text-xs uppercase text-slate-500">
            <tr>
              <th class="px-4 py-3 font-medium">ID</th>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Quantity</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {products.map((product) => (
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 text-slate-500">{product.id}</td>
                <td class="px-4 py-3 font-medium">{product.name}</td>
                <td class="px-4 py-3">{product.quantity ?? 0}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <section class="mt-10 rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold">Add Product</h2>
      <form method="POST" action="/api/products" class="mt-4 flex flex-col gap-4">
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
          Name
          <input
            type="text"
            name="name"
            required
            class="rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
          />
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
          SKU (optional)
          <input
            type="text"
            name="sku"
            class="rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
          />
        </label>
        <button
          type="submit"
          class="self-start rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
        >
          Add Product
        </button>
      </form>
    </section>
  </div>
</AppLayout>