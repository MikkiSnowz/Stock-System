---
import { env } from "cloudflare:workers";
import AppLayout from "../layouts/AppLayout.astro";

interface ProductRow {
  id: number;
  name: string;
  sku: string | null;
  quantity: number | null;
}

const LOW_STOCK_THRESHOLD = 10;

const db = env.stock_db;
const { results } = await db.prepare(`
  SELECT p.id, p.name, p.sku, SUM(sl.quantity) as quantity
  FROM products p
  LEFT JOIN stock_levels sl ON sl.product_id = p.id
  GROUP BY p.id, p.name, p.sku
  ORDER BY p.name COLLATE NOCASE
`).all();
const products = results as unknown as ProductRow[];

const quantityOf = (product: ProductRow) => product.quantity ?? 0;
const totalUnits = products.reduce((sum, product) => sum + quantityOf(product), 0);
const outOfStock = products.filter((product) => quantityOf(product) <= 0).length;
const lowStock = products.filter(
  (product) => quantityOf(product) > 0 && quantityOf(product) <= LOW_STOCK_THRESHOLD
).length;

const stats = [
  { label: "Products", value: products.length, tone: "text-slate-900" },
  { label: "Total units", value: totalUnits, tone: "text-slate-900" },
  { label: "Low stock", value: lowStock, tone: "text-amber-600" },
  { label: "Out of stock", value: outOfStock, tone: "text-red-600" }
];

function status(product: ProductRow) {
  const quantity = quantityOf(product);
  if (quantity <= 0) return { label: "Out of stock", classes: "bg-red-50 text-red-700 ring-red-600/20" };
  if (quantity <= LOW_STOCK_THRESHOLD) return { label: "Low stock", classes: "bg-amber-50 text-amber-700 ring-amber-600/20" };
  return { label: "In stock", classes: "bg-green-50 text-green-700 ring-green-600/20" };
}

const inputClass =
  "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500";
---

<AppLayout title="Stock System">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <header>
      <h1 class="text-2xl font-semibold tracking-tight">Inventory</h1>
      <p class="mt-1 text-sm text-slate-500">Track products and stock levels across your locations.</p>
    </header>

    <dl class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">{stat.label}</dt>
          <dd class={`mt-2 text-3xl font-semibold tabular-nums ${stat.tone}`}>{stat.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-6 grid items-start gap-6 lg:grid-cols-3">
      <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm lg:col-span-2">
        <div class="flex items-center justify-between gap-4 border-b border-slate-200 px-4 py-3">
          <h2 class="text-base font-semibold">Products</h2>
          <input
            type="search"
            id="product-search"
            placeholder="Search name or SKU…"
            aria-label="Search products"
            class={`${inputClass} w-56`}
          />
        </div>

        {products.length === 0 ? (
          <p class="p-8 text-center text-sm text-slate-500">
            No products yet. Add your first one using the form.
          </p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th class="px-4 py-3 font-medium">Product</th>
                  <th class="px-4 py-3 font-medium">SKU</th>
                  <th class="px-4 py-3 text-right font-medium">Quantity</th>
                  <th class="px-4 py-3 font-medium">Status</th>
                  <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {products.map((product) => {
                  const badge = status(product);
                  return (
                    <tr
                      class="product-row hover:bg-slate-50"
                      data-search={`${product.name} ${product.sku ?? ""}`.toLowerCase()}
                    >

                      <td class="px-4 py-3 font-medium">{product.name}</td>
                      <td class="px-4 py-3 font-mono text-xs text-slate-500">{product.sku ?? "—"}</td>
                      <td class="px-4 py-3 text-right tabular-nums">{quantityOf(product)}</td>
                      <td class="px-4 py-3">
                        <span class={`inline-flex rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${badge.classes}`}>
                          {badge.label}
                        </span>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <form
                          method="POST"
                          action="/api/products/delete"
                          onsubmit="return confirm('Delete this product and its stock history?')"
                        >
                          <input type="hidden" name="id" value={product.id} />
                          <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-800">
                            Delete
                          </button>
                        </form>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <p id="no-results" class="hidden p-8 text-center text-sm text-slate-500">
              No products match your search.
            </p>
          </div>
        )}
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-base font-semibold">Add product</h2>
        <form method="POST" action="/api/products" class="mt-4 flex flex-col gap-4">
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
            Name
            <input type="text" name="name" required class={inputClass} />
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
            SKU <span class="font-normal text-slate-400">(optional)</span>
            <input type="text" name="sku" class={inputClass} />
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
            Starting quantity
            <input type="number" name="quantity" min="0" step="1" value="0" class={inputClass} />
          </label>
          <button
            type="submit"
            class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
          >
            Add product
          </button>
        </form>
      </section>
    </div>
  </div>
</AppLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#product-search");
  const rows = document.querySelectorAll<HTMLElement>(".product-row");
  const empty = document.querySelector<HTMLElement>("#no-results");

  search?.addEventListener("input", () => {
    const term = search.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = (row.dataset.search ?? "").includes(term);
      row.hidden = !match;
      if (match) visible += 1;
    });
    empty?.classList.toggle("hidden", visible > 0);
  });
</script>
