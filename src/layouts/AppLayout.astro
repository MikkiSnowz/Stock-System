---
import Layout from "./Layout.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title?: string;
}

const { title = "Stock System" } = Astro.props;
---

<Layout title={title}>
  <div class="flex min-h-screen">
    <Sidebar />

    <main class="min-w-0 flex-1 p-6">
      <slot />
    </main>
  </div>
</Layout>