---
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Inventory" },
  { href: "/profile", label: "Profile" }
];
---

<aside class="min-h-screen w-56 shrink-0 bg-slate-800 p-4 text-white">
  <a class="mb-8 block text-xl font-bold text-white no-underline" href="/">
    Stock System
  </a>

  <nav aria-label="Main navigation" class="flex flex-col gap-1">
    {links.map((link) => (
      <a
        class:list={[
          "block rounded-md px-3 py-2 text-white no-underline hover:bg-slate-700",
          pathname === link.href && "bg-slate-700"
        ]}
        href={link.href}
        aria-current={pathname === link.href ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <form method="POST" action="/api/auth/logout" class="mt-8">
    <button
      type="submit"
      class="rounded-md px-3 py-2 text-sm text-slate-200 hover:bg-slate-700"
    >
      Sign out
    </button>
  </form>
</aside>